# BPEXCH / Lucky Thai Win - Environment Variable Configuration Template
# Copy this file to .env or configure these variables in Vercel / GitHub Secrets

# Application Configuration
NODE_ENV=production
PORT=3000

# Public API Endpoint
NEXT_PUBLIC_API_URL=https://thaiwin.vercel.app

# Database & Authentication (If connecting to custom backend)
DATABASE_URL=postgresql://user:password@localhost:5432/bpexch_db
JWT_SECRET=your_jwt_secret_key_here

# Vercel Integration
VERCEL_URL=
