{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Frame-Options", "value": "ALLOWALL" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ritmu-proxy",
      "destination": "https://www.ritmu.tv/"
    },
    {
      "source": "/ritmu-proxy/:path*",
      "destination": "https://www.ritmu.tv/:path*"
    }
  ]
}
